# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# Origin allowed to call this API with credentials (the deployed frontend).
# In local dev, Vite proxies /api through its own origin so this mostly
# matters for a production deployment where client and API are separate origins.
ALLOWED_ORIGIN=http://localhost:5173

# Required. Long random string used to sign CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# CRM integration, one per market — see server/src/config/markets.ts. The
# country segment in the URL (/fr/visibilite, /ma/visibilite, /sn/visibilite)
# decides which of these a lead is sent to; adding a market later is just
# adding its 3 lines here (plus its code in SUPPORTED_MARKETS), no code change.
# Leave a market's API_URL/API_KEY empty to run without a CRM for it: leads
# are still captured and stored locally with status "pending" for later
# replay — see server/src/services/crm/UnconfiguredCrmClient.ts.

# France (CRM_API_URL/_API_KEY/_PIPELINE/_SOURCE with no market prefix also
# work as an alias for these — kept for backward compatibility).
CRM_FR_API_URL=
CRM_FR_API_KEY=
CRM_FR_PIPELINE=
CRM_FR_SOURCE=nfc-retail-landing-fr

# Maroc — not live yet, safe to leave empty until the CRM Maroc WS exists.
CRM_MA_API_URL=
CRM_MA_API_KEY=
CRM_MA_PIPELINE=
CRM_MA_SOURCE=nfc-retail-landing-ma

# Sénégal — not live yet, safe to leave empty until the CRM Sénégal WS exists.
CRM_SN_API_URL=
CRM_SN_API_KEY=
CRM_SN_PIPELINE=
CRM_SN_SOURCE=nfc-retail-landing-sn

# Where locally-stored leads are appended (JSON Lines), relative to server/.
LEAD_STORE_PATH=./data/leads.jsonl

# Optional: notified when a new lead comes in, if/once notification wiring
# is added on top of LeadService (brief §55 — "email de notification des leads").
LEAD_NOTIFICATION_EMAIL=
