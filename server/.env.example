# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# Origin allowed to call this API with credentials (the deployed frontend).
# In local dev, Vite proxies /api through its own origin so this mostly
# matters for a production deployment where client and API are separate origins.
ALLOWED_ORIGIN=http://localhost:5173

# Required. Long random string used to sign CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# CRM integration (brief §15). Leave empty to run without a CRM: leads are
# still captured and stored locally with status "pending" for later replay —
# see server/src/services/crm/UnconfiguredCrmClient.ts.
CRM_API_URL=
CRM_API_KEY=
CRM_PIPELINE=
CRM_SOURCE=nfc-retail-landing-fr

# Where locally-stored leads are appended (JSON Lines), relative to server/.
LEAD_STORE_PATH=./data/leads.jsonl

# Optional: notified when a new lead comes in, if/once notification wiring
# is added on top of LeadService (brief §55 — "email de notification des leads").
LEAD_NOTIFICATION_EMAIL=
