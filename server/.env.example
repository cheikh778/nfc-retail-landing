# Copy this file to .env and fill in real values. Never commit .env.
# Put secrets (Bearer tokens, CSRF_SECRET) in .env.local instead — it is
# gitignored and loaded after .env, so it overrides values set here.

NODE_ENV=development
PORT=3001

# Comma-separated allowlist of browser origins allowed to call this API with
# credentials. Local dev = the Next dev server. Production MUST be the real
# apex over HTTPS (e.g. https://nfcretail.com), optionally + a *.pages.dev
# preview URL while testing. A localhost or http:// value in production only
# logs a warning, but the `secure` CSRF cookie will not work over http.
ALLOWED_ORIGIN=http://localhost:3000

# Required, >= 24 chars. Long random string used to sign CSRF tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# CRM integration, one per market — see server/src/config/markets.ts. The
# country segment in the URL (/fr/visibilite, /ma/visibilite, /sn/visibilite)
# decides which of these a lead is sent to; adding a market later is just
# adding its lines here (plus its code in SUPPORTED_MARKETS), no code change.
# Leave a market's API_URL/API_KEY empty to run without a CRM for it: leads
# are still captured and stored locally with status "pending" for later
# replay — see server/src/services/crm/UnconfiguredCrmClient.ts.
#
# _API_KEY is a Bearer token: keep it ONLY here (server env), never in the
# frontend bundle and never committed. _LOCALE / _OFFER_CODE feed the CRM
# "LeadInbound" payload (see server/src/services/crm/HttpCrmClient.ts).

# France — LeadInbound contract, endpoint https://up.moncrm.io/api/v1/leads.
# (CRM_API_URL/_API_KEY with no market prefix also work as an alias — legacy.)
CRM_FR_API_URL=https://up.moncrm.io/api/v1/leads
CRM_FR_API_KEY=
CRM_FR_LOCALE=fr-FR
CRM_FR_OFFER_CODE=visibilite

# Maroc — not live yet, safe to leave empty until the CRM Maroc WS exists.
CRM_MA_API_URL=
CRM_MA_API_KEY=
CRM_MA_LOCALE=fr-MA
CRM_MA_OFFER_CODE=visibilite

# Sénégal — not live yet, safe to leave empty until the CRM Sénégal WS exists.
CRM_SN_API_URL=
CRM_SN_API_KEY=
CRM_SN_LOCALE=fr-SN
CRM_SN_OFFER_CODE=visibilite

# Where locally-stored leads are appended (JSON Lines), relative to server/.
LEAD_STORE_PATH=./data/leads.jsonl

# Optional: notified when a new lead comes in, if/once notification wiring
# is added on top of LeadService (brief §55 — "email de notification des leads").
LEAD_NOTIFICATION_EMAIL=
