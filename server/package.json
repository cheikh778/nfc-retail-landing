{
  "name": "nfc-retail-landing-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "replay:leads": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/scripts/replayPendingLeads.ts",
    "leads:list": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/scripts/listLeads.ts",
    "test": "vitest run"
  },
  "//": "typescript + the @types used in src/ live in dependencies (not devDependencies) so a host that installs prod-only and then runs `npm run build` still has tsc — e.g. Hostinger Deployments.",
  "dependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "typescript": "~6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.0"
  }
}
