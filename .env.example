# Copy this file to .env.local to override defaults locally. Never commit
# a real .env.local — Vite's .gitignore already excludes it.

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to skip loading GA4
# entirely — see src/lib/ga4.ts. Never invent a real ID here.
VITE_GA4_MEASUREMENT_ID=

# Base path for API calls. Defaults to '/api', which Vite's dev server
# proxies to the local API (see vite.config.ts) — you shouldn't need to set
# this unless the API lives on a different origin in your deployment.
VITE_API_BASE_URL=
