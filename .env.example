# Copy to .env.local to override locally. Never commit a real .env.local.
# Next inlines every NEXT_PUBLIC_* value into the browser bundle — none of
# these are secrets.

# Base URL of the Symfony lead API (separate repo). The client POSTs to
# ${NEXT_PUBLIC_API_BASE_URL}/fr/visibilite/lead — see lib/api.ts.
# Leave empty locally to see the form's error path; set it to a running API
# (or a mock) to test the happy path.
NEXT_PUBLIC_API_BASE_URL=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Empty = GA4 never loads. See lib/ga4.ts.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
