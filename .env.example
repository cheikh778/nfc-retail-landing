# Copy to .env.local to override locally. Never commit a real .env.local.
# Next inlines every NEXT_PUBLIC_* value into the browser bundle — none of
# these are secrets (the CRM Bearer token lives only in the `nfcretail-api` repo).

# Origin of the lead API (separate repo: nfcretail-api). The client calls
# ${NEXT_PUBLIC_API_BASE_URL}/api/csrf-token then
# ${NEXT_PUBLIC_API_BASE_URL}/api/fr/visibilite/lead — see lib/api.ts.
# Local: clone nfcretail-api next to this repo and run `npm run dev` there
# (defaults to port 3001). Leave empty to exercise the form's error path.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Empty = GA4 never loads. See lib/ga4.ts.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
