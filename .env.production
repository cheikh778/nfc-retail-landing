# Loaded automatically by `vite build` (production mode). NOT a secret — a
# VITE_* value is inlined into the public browser bundle. Committed on purpose
# so Cloudflare Pages builds with the right API host without dashboard config.

# The landing (nfcretail.com) and the API (api.nfcretail.com) are separate
# origins in production, so the API base must be absolute — see src/lib/api.ts.
VITE_API_BASE_URL=https://api.nfcretail.com/api

# Set the real GA4 property ID here when analytics is wired (or in the
# Cloudflare Pages dashboard env vars). Empty = GA4 not loaded.
VITE_GA4_MEASUREMENT_ID=
