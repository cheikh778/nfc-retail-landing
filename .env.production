# Loaded automatically by `next build` (production). NOT secret — a
# NEXT_PUBLIC_* value is inlined into the public browser bundle. Committed so
# the static build targets the right API host without dashboard config.

# The landing (nfcretail.com) and the lead API (api.nfcretail.com) share the
# root domain → same-site → the SameSite=Lax CSRF cookie is sent without
# extra config. The client appends /api/... itself (see lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=https://api.nfcretail.com

# Set the real GA4 property ID here when analytics is wired. Empty = not loaded.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
